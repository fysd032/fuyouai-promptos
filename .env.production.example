# Production Environment Variables
# Copy this to Vercel Dashboard → Settings → Environment Variables

# ==================== REQUIRED ====================

# Supabase (Client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase (Server - Service Role)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Engine
DEEPSEEK_API_KEY=your-deepseek-key

# Payment (Creem)
CREEM_API_KEY=your-creem-api-key
CREEM_ENV=live
CREEM_PRODUCT_ID_BASIC=prod_xxx
CREEM_PRODUCT_ID_PRO=prod_xxx
CREEM_PRODUCT_ID_STARTER=prod_xxx
CREEM_WEBHOOK_SECRET_LIVE=whsec_xxx

# ==================== OPTIONAL ====================

# Redis Cache (recommended for performance)
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Gemini (optional AI engine)
GEMINI_API_KEY=your-gemini-key

# App URL
APP_URL=https://fuyouai.com

# Billing
BILLING_ENABLED=1

# Gate logging (set to "1" to enable detailed logs)
GATE_LOG=0

# ==================== DO NOT SET IN PRODUCTION ====================

# NEVER set these in production:
# NEXT_PUBLIC_DEV_MODE=true          ❌ Bypasses all access control
# NEXT_PUBLIC_INVITE_ENABLED=false   ❌ Opens access to everyone
